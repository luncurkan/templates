{
  "builder": {
    "lang": "rust",
    "version": "latest",
    "command": "./target/release/rust-axum-url-shortener"
  },
  "env": {
    "PORT": "3000",
    "HOST": "0.0.0.0",
    "RUST_LOG": "info",
    "DATABASE_MAX_CONNECTIONS": "5",
    "BASE_URL": "http://localhost:3000"
  },
  "database": {
    "managed": true
  },
  "resources": {
    "cpu": 100,
    "memory": 100
  }
}
